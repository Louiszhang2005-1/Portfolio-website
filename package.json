{
  "name": "portfolio-ship",
  "private": true,
  "workspaces": [
    "portfolio"
  ],
  "scripts": {
    "build": "npm --workspace portfolio run build",
    "dev": "npm --workspace portfolio run dev",
    "dev:smoke": "npm --workspace portfolio run dev:smoke",
    "dev:turbo": "npm --workspace portfolio run dev:turbo",
    "start": "npm --workspace portfolio run start",
    "lint": "npm --workspace portfolio run lint"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "@tailwindcss/oxide-linux-x64-musl": "^4.2.2",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  }
}
